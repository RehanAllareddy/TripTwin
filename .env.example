# Copy to .env.local (git-ignored) for local development, and add the same names in
# Vercel → Project → Settings → Environment Variables for deployments.
# Never commit real keys.

# Browser key: used in the app/website for the Places UI Kit (ratings) and the
# Maps Embed API (360° viewer). Restrict it by HTTP referrer (see README).
EXPO_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Server key: used ONLY by /api/streetview (Vercel function) and the
# `npm run verify:destinations` script. Never prefix with EXPO_PUBLIC_.
GOOGLE_MAPS_SERVER_KEY=

# The deployed website, e.g. https://your-app.vercel.app (no trailing slash).
# The phone app loads the globe and Google content from here.
EXPO_PUBLIC_SITE_URL=

# Optional, local development only: point the app at a deployed API,
# because `npx expo start` does not run Vercel's /api functions.
EXPO_PUBLIC_API_BASE_URL=
